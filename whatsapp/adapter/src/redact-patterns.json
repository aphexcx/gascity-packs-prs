[
  {
    "kind": "bearer",
    "pattern": "(?i:\\bBearer[ \\t]+)[A-Za-z0-9._~+/-]+=*"
  },
  {
    "kind": "anthropic",
    "pattern": "sk-ant-[A-Za-z0-9_-]{8,}"
  },
  {
    "kind": "openai",
    "pattern": "sk-[A-Za-z0-9_-]{8,}"
  },
  {
    "kind": "slack",
    "pattern": "(?:xoxb-|xoxp-|xapp-)[A-Za-z0-9_-]{8,}"
  },
  {
    "kind": "github",
    "pattern": "(?:ghp_|gho_|github_pat_)[A-Za-z0-9_]{8,}"
  },
  {
    "kind": "aws",
    "pattern": "AKIA[A-Z0-9]{16,}"
  },
  {
    "kind": "google",
    "pattern": "AIza[A-Za-z0-9_-]{8,}"
  },
  {
    "kind": "jwt",
    "pattern": "(?:^|[^A-Za-z0-9_-])(?P<token>eyJ[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{8,})"
  },
  {
    "kind": "hex",
    "pattern": "[A-Fa-f0-9]{32,}"
  },
  {
    "kind": "base64",
    "pattern": "[A-Za-z0-9_+/-]{40,}=*",
    "min_distinct": 5,
    "allowlist": [
      "https://[A-Za-z0-9-]{1,37}\\.slack\\.com/archives/[CDG](?:[A-Z0-9]{8}|[A-Z0-9]{10})/p[0-9]{16}",
      "(?:^|[ \\t\\n\\r\\f\\x0b<])[Hh][Tt][Tt][Pp][Ss]://[Xx]\\.[Cc][Oo][Mm]/[A-Za-z0-9._~:/?#@!$%&*+,;=-]*"
    ]
  }
]
