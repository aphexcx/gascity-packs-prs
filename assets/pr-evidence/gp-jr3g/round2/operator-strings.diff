diff --git a/gchat/adapter/internal/catchup/history.go b/gchat/adapter/internal/catchup/history.go
new file mode 100644
index 00000000..110a0ceb
--- /dev/null
+++ b/gchat/adapter/internal/catchup/history.go
@@ -0,0 +1,74 @@
+package catchup
+
+import (
+   "encoding/json"
+   "fmt"
+   "time"
+
+   "gchat-adapter/internal/config"
+   "gchat-adapter/internal/inbound"
+   "gchat-adapter/internal/ledger"
+   "gchat-adapter/internal/puller"
+)
+
+// InitializeHistory upgrades the saved inventory before any workers or polls
+// can read it. It never gives an existing installation a global floor.
+func InitializeHistory(l *ledger.Ledger, cfg *config.Config, now time.Time, log puller.Logger) error {
+   if l.SpacesListedAt.IsZero() && l.HistoryFloor.IsZero() {
+       l.SpacesListedAt = now.UTC()
+   }
+   for _, c := range l.Changes {
+       if c.Reason == "before_history_floor" {
+           c.Reason, c.Cause = "local", "before_history_floor"
+       }
+   }
+   for name, s := range l.Spaces {
+       if err := startSpace(l, cfg, name, s, now, log); err != nil {
+           return err
+       }
+   }
+   return nil
+}
+
+func startSpace(l *ledger.Ledger, cfg *config.Config, name string, s *ledger.SpaceState, now time.Time, log puller.Logger) error {
+   if !l.StartSpace(s, now) {
+       return nil
+   }
+   bound := ledger.HistoryBound(s, l.HistoryFloor)
+   if !s.FrozenUpper.IsZero() {
+       p, err := decodeProgress(s.PageToken)
+       if err != nil {
+           return err
+       }
+       p.Phase, p.Token = "messages", ""
+       p.MessageLower, p.EventLower = bound, bound
+       p.Reported = false
+       if s.FrozenUpper.Before(bound) {
+           s.FrozenUpper = bound
+       }
+       s.PageToken = encode(p)
+   }
+   kept := s.Backlog[:0]
+   for _, raw := range s.Backlog {
+       var item queuedChange
+       if err := json.Unmarshal([]byte(raw), &item); err != nil {
+           return fmt.Errorf("catchup: invalid durable backlog for %s", name)
+       }
+       if item.Change.EventTime.IsZero() {
+           item.Change.EventTime = item.At
+       }
+       if item.Malformed == "" && inbound.HistorySkipCause(l, item.Change) != "" {
+           inbound.RetireQueuedHistory(l, item.Change)
+           added := inbound.RetainHistorySkip(l, cfg, item.Change, now, inbound.HistorySpeaker(l, cfg, item.Change), true, l.IdentityUserID)
+           if added && item.Change.ActTime().IsZero() && log != nil {
+               log.Warn("inbound act has no usable history time", "space", name, "kind", item.Change.Kind)
+           }
+           l.Counters["history_backlog_skipped:"+name]++
+           continue
+       }
+       kept = append(kept, raw)
+   }
+   s.Backlog = kept
+   inbound.RetireSpaceHistory(l, cfg, name, log)
+   return nil
+}
diff --git a/gchat/adapter/internal/inbound/history.go b/gchat/adapter/internal/inbound/history.go
new file mode 100644
index 00000000..835e97d6
--- /dev/null
+++ b/gchat/adapter/internal/inbound/history.go
@@ -0,0 +1,296 @@
+package inbound
+
+import (
+   "context"
+   "encoding/json"
+   "strings"
+   "time"
+
+   "gchat-adapter/internal/config"
+   "gchat-adapter/internal/ledger"
+   "gchat-adapter/internal/principal"
+   "gchat-adapter/internal/provenance"
+   "gchat-adapter/internal/puller"
+   "gchat-adapter/internal/wire"
+   api "google.golang.org/api/chat/v1"
+)
+
+// HistorySkipCause is empty for unbounded spaces and current acts.
+func HistorySkipCause(l *ledger.Ledger, c puller.Change) string {
+   bound := ledger.HistoryBound(l.Spaces[c.Space], l.HistoryFloor)
+   if bound.IsZero() {
+       return ""
+   }
+   at := c.ActTime()
+   if at.IsZero() {
+       return "history_time_missing"
+   }
+   if at.Before(bound) {
+       return "before_history_floor"
+   }
+   return ""
+}
+
+func historyID(c puller.Change) string {
+   name := ""
+   if c.Message != nil {
+       name = c.Message.Name
+       if c.Kind == "message.created" && !c.ActTime().IsZero() {
+           return name
+       }
+   }
+   if c.Reaction != nil {
+       name = c.Reaction.Name
+   }
+   return name + "#history#" + c.Kind + "#" + c.ActTime().UTC().Format(time.RFC3339Nano)
+}
+
+// Use the selected fallback in message revision IDs as well as in the bound.
+// An absent resource time must not consume a later act with another publish time.
+func historyTime(c puller.Change) puller.Change {
+   if c.Message == nil || c.ActTime().IsZero() {
+       return c
+   }
+   raw := c.Message.CreateTime
+   if c.Kind == "message.updated" {
+       raw = c.Message.LastUpdateTime
+   }
+   if _, err := time.Parse(time.RFC3339Nano, raw); err == nil {
+       return c
+   }
+   m := *c.Message
+   if c.Kind == "message.created" {
+       m.CreateTime = c.ActTime().UTC().Format(time.RFC3339Nano)
+   }
+   if c.Kind == "message.updated" {
+       m.LastUpdateTime = c.ActTime().UTC().Format(time.RFC3339Nano)
+   }
+   c.Message = &m
+   return c
+}
+
+func historyUser(c puller.Change) *api.User {
+   if c.Message != nil {
+       return c.Message.Sender
+   }
+   if c.Reaction != nil {
+       return c.Reaction.User
+   }
+   return nil
+}
+
+// RetireQueuedHistory removes the delivery state of one old queued act before
+// load-time migration retains its frame-only skip. A handled queue row can
+// still have an intent, receipt or unresolved record that Poll would resume.
+// Never erase an already committed delivery or another revision of the item.
+func RetireQueuedHistory(l *ledger.Ledger, c puller.Change) {
+   if HistorySkipCause(l, c) == "" {
+       return
+   }
+   id := ""
+   if c.Message != nil {
+       id = c.Message.Name
+       switch c.Kind {
+       case "message.updated":
+           baseID := id
+           id += "#updated#" + c.Message.LastUpdateTime
+           if l.Changes[id] == nil {
+               if base := l.Changes[baseID]; base != nil && base.Kind == c.Kind && base.Created.Before(ledger.HistoryBound(l.Spaces[c.Space], l.HistoryFloor)) {
+                   id = baseID
+               }
+           }
+       case "message.deleted":
+           id += "#deleted"
+       }
+   } else if c.Reaction != nil {
+       id = c.Reaction.Name + "#" + strings.TrimPrefix(c.Kind, "reaction.")
+   }
+   if old := l.Changes[id]; old != nil && old.Kind == c.Kind && old.Status != "committed" {
+       delete(l.Changes, id)
+       delete(l.Unresolved, id)
+       if c.Kind == "message.deleted" {
+           if state := l.Messages[c.Message.Name]; state != nil {
+               state.Deleted = false
+           }
+       }
+   }
+}
+
+// RetireSpaceHistory handles attempts that outlived their catch-up queue row.
+// An attempt recorded before a newly installed bound necessarily predates it;
+// its Created time is an upper bound on the act, not a replacement event time.
+// Existing cursors never call this migration, and committed deliveries survive.
+func RetireSpaceHistory(l *ledger.Ledger, cfg *config.Config, space string, log puller.Logger) {
+   bound := ledger.HistoryBound(l.Spaces[space], l.HistoryFloor)
+   if bound.IsZero() {
+       return
