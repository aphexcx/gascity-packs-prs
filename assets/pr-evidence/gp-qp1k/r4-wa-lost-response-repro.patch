+test('never-silent lost send response replay cannot answer a newer failed request', async (t) => {
+  const f = fixture(t);
+  let accepted = false;
+  let sends = 0;
+  const gateway = { window: async () => ({ windows: [{ conversation_id: 'example-owner' }] }), send: async () => {
+    if (!accepted) {
+      accepted = true;
+      sends++;
+      throw Object.assign(new Error('accepted but response lost'), { noAnswer: true });
+    }
+    return { message_id: 'original-proof' };
+  } };
+  const make = () => createPublisher({ stateDir: f.opts.stateDir, gateway, clock: () => f.now, notices: f.e });
+  const body = { session_id: 'original-session', conversation: { conversation_id: 'example-owner' }, text: 'old reply', idempotency_key: 'original-key' };
+  assert.equal((await make().handlePublish(JSON.stringify(body))).json.delivered, false);
+  f.now += 1000;
+  f.e.track({ id: 'new-inbound', conversation: 'example-owner', targets: ['original-session'] });
+  f.e.result('new-inbound', 'failed', ['original-session']);
+  f.now += 1000;
+  assert.equal((await make().handlePublish(JSON.stringify(body))).json.delivered, true);
+  assert.equal(sends, 1, 'retry did not send new words');
+  f.now += 180000;
+  f.e.result('new-inbound', 'failed', ['original-session']);
+  await f.e.poll();
+  assert.deepEqual([f.posts.length, f.mails.length], [1, 1], 'old acknowledgement suppressed the newer failure');
+});
