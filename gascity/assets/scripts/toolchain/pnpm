#!/bin/sh
# pnpm — gc worker toolchain wrapper. Install as $CITY/.gc/shims/toolchain/pnpm
# (README, "Worker toolchain"), the directory a provider shim puts first on
# PATH for every worker session and its child processes.
#
# What it does, in order:
#   1. pnpm itself is installed ONCE per version under the city, never
#      machine-wide: <toolchain dir>/pnpm/v<version>/node_modules/.bin/pnpm
#      (npm --prefix), so a changed PNPM_VERSION is a new install, never a
#      stale cache. The first caller installs, concurrent callers wait for
#      it; a caller that still finds no binary runs `npx -y pnpm@<version>`
#      for this one command.
#   2. pnpm's own in-command install is turned off for the command it runs
#      (pnpm_config_verify_deps_before_run=false, the one value the
#      environment prefix reaches). pnpm 11 defaults verify-deps-before-run
#      to "install": every `pnpm run`, `pnpm exec`, `pnpm test` and bare
#      `pnpm <script>` first re-runs `pnpm install` when node_modules is out
#      of sync (missing after a fresh lane, stale after a branch switch), and
#      parallel read-only checks then race on the same node_modules. The
#      lane path below is the one path that installs.
#   3. Every command is one of three kinds, decided by the first bare token
#      after the global options and the prefixes pnpm accepts
#      (`recursive`/`multi`/`m`, `pm`, `with <runtime>`); an option that
#      takes a separate value (`--filter app`, `-C dir`) has that value
#      skipped. The directory pnpm acts on, TARGET, is the last `-C`,
#      `--dir` or `--prefix` value in pnpm's own option scope (the whole line
#      for a built-in; for `run`/`exec` up to the script or bin name, whose
#      own arguments are its own; a bare script name ends the scope), else
#      the working directory.
#        info    — reports or manages state outside node_modules (`store`,
#                  `config`, `list`, `outdated`, `--version`, `help`, ...):
#                  runs as is, touches no lock.
#        mutate  — every pnpm 11.20 built-in that can change node_modules
#                  (`install`, `ci`, `add`, `remove`, `update`, `link`,
#                  `prune`, `dedupe`, `rebuild`, `clean`, `purge`, ...): runs
#                  where typed, arguments unchanged, under the lane lock, so
#                  it never overlaps another caller's install.
#        project — `run`, `exec`, `test`, a bare script or bin name, anything
#                  else: first makes sure the lane is in sync, then runs.
#      In sync is pnpm's own word, never this wrapper's: before a project
#      command the wrapper asks pnpm read-only, in TARGET, with
#      `--config.verify-deps-before-run=error` (the flag; the environment
#      prefix installs for any value but false) and a command that runs
#      nothing (`exec true`). pnpm's checkDepsStatus compares node_modules
#      with the lockfile, every manifest, the workspace membership and the
#      settings, and answers yes (exit 0) or no (a VERIFY_DEPS_BEFORE_RUN
#      error, node_modules missing included). Yes: the command runs. No: one
#      caller takes <lane>/node_modules/.gc-lane-deps.lock (mkdir; the lane
#      is the nearest ancestor of TARGET holding pnpm-lock.yaml; a project
#      command with no lockfile above it runs as is), asks pnpm again under
#      the lock (another caller may have installed meanwhile), runs `pnpm
#      install --frozen-lockfile` in the lane when the answer is still no,
#      and releases; every concurrent caller waits for the lock and asks
#      pnpm again. A failed install fails the command (exit status of pnpm
#      install): the requested command does not run. pnpm fails the frozen
#      install closed when a manifest is ahead of the lockfile; the worker's
#      own `pnpm install` (a mutate) resolves that.
#      A lock whose owner pid is dead (or a zombie), or that has no owner
#      after two minutes, is moved aside by rename (atomic; nothing is
#      deleted) and retaken, but only under a second, atomic reclaim lock
#      and only after re-checking it is still the same stale lock, so two
#      waiters cannot both clear it and a live lock (a waiter's fresh one)
#      is never moved; a reclaim lock stuck for two minutes fails the command
#      closed. A live lock is waited for up to <wait> seconds, then this
#      command fails closed naming the holder. Only the pid that took the
#      lock releases it. A lifecycle script that a mutate or install runs
#      (a `postinstall` that calls `pnpm run build`) re-enters this wrapper
#      with the lane already locked by its parent: the locking wrapper
#      exports GC_TOOLCHAIN_LANE_DEPS_INSTALLING=<lane> and a descendant
#      that resolves the same lane runs as info, never asking pnpm or
#      waiting on its parent's lock.
#   4. The wrapper's own directory goes first on PATH, so the node pnpm runs
#      on (and every script it runs) is the toolchain's node when the city
#      pinned one (see the node wrapper beside this file).
#
# Settings (environment wins; then toolchain.env beside this file, plain
# KEY=VALUE lines, never evaluated; then the default):
#   GC_TOOLCHAIN_DIR / TOOLCHAIN_DIR             where pinned tools live
#                                                (default: <shim dir>/../../toolchain,
#                                                 i.e. $CITY/.gc/toolchain)
#   GC_TOOLCHAIN_PNPM_VERSION / PNPM_VERSION     pnpm to install (default 11.20.0;
#                                                pnpm honours a repo's packageManager
#                                                pin on top of it)
#   GC_TOOLCHAIN_LANE_DEPS / LANE_DEPS           "off": every command runs as info
#   GC_TOOLCHAIN_LANE_DEPS_WAIT / LANE_DEPS_WAIT seconds to wait for another
#                                                caller's lock (default 600)

set -eu

log() { printf 'gc-toolchain pnpm: %s\n' "$*" >&2; }
warn() { printf 'gc-toolchain pnpm: WARN %s\n' "$*" >&2; }
die() { printf 'gc-toolchain pnpm: ERROR %s\n' "$*" >&2; exit 1; }

# --- locate self with parameter expansion only ------------------------------------
case "$0" in
    */*) self_dir="${0%/*}" ;;
    *)   self_dir="." ;;
esac
[ -n "$self_dir" ] || self_dir="/"
SELF_DIR="$(cd -P "$self_dir" 2>/dev/null && pwd -P)" || die "cannot resolve my own directory from $0"
SIDECAR="$SELF_DIR/toolchain.env"

# setting NAME ENV_NAME DEFAULT: environment (even empty) wins over the
# sidecar; the sidecar is read as text, first matching line, never evaluated.
setting() {
    # shellcheck disable=SC2154  # v is assigned by the eval on the next line
    eval "v=\${$2-__unset__}"
    if [ "$v" != "__unset__" ]; then
        printf '%s\n' "$v"
        return 0
    fi
    if [ -r "$SIDECAR" ]; then
        line="$(grep -- "^$1=" "$SIDECAR" 2>/dev/null | sed -n '1p')"
        if [ -n "$line" ]; then
            printf '%s\n' "${line#*=}"
            return 0
        fi
    fi
    printf '%s\n' "$3"
}

TOOLCHAIN_DIR="$(setting TOOLCHAIN_DIR GC_TOOLCHAIN_DIR "")"
if [ -z "$TOOLCHAIN_DIR" ]; then
    TOOLCHAIN_DIR="$SELF_DIR/../../toolchain"
fi
case "$TOOLCHAIN_DIR" in
    /*) ;;
    *) TOOLCHAIN_DIR="$SELF_DIR/$TOOLCHAIN_DIR" ;;
esac
PNPM_VERSION="$(setting PNPM_VERSION GC_TOOLCHAIN_PNPM_VERSION 11.20.0)"
LANE_DEPS="$(setting LANE_DEPS GC_TOOLCHAIN_LANE_DEPS on)"
LANE_DEPS_WAIT="$(setting LANE_DEPS_WAIT GC_TOOLCHAIN_LANE_DEPS_WAIT 600)"
case "$LANE_DEPS_WAIT" in
    ''|*[!0-9]*) LANE_DEPS_WAIT=600 ;;
esac

# The toolchain's own tools first, so `node` under pnpm is the pinned one.
case ":$PATH:" in
    "$SELF_DIR:"*) ;;
    *) PATH="$SELF_DIR:$PATH" ;;
esac
export PATH

# --- 1. pnpm itself, once per version under the city -------------------------------
PNPM_ROOT="$TOOLCHAIN_DIR/pnpm/v$PNPM_VERSION"
PNPM_BIN="$PNPM_ROOT/node_modules/.bin/pnpm"
if [ ! -x "$PNPM_BIN" ]; then
    if mkdir -p "$PNPM_ROOT" 2>/dev/null && mkdir "$PNPM_ROOT/.installing" 2>/dev/null; then
        log "installing pnpm $PNPM_VERSION once under $PNPM_ROOT"
        npm install --prefix "$PNPM_ROOT" --no-audit --no-fund --loglevel=error "pnpm@$PNPM_VERSION" >&2 \
            || warn "pnpm $PNPM_VERSION did not install under $PNPM_ROOT"
        rmdir "$PNPM_ROOT/.installing" 2>/dev/null || true
    else
        waited=0
        while [ -d "$PNPM_ROOT/.installing" ] && [ "$waited" -lt 120 ]; do
            [ "$waited" -gt 0 ] || log "waiting for another caller's pnpm install"
            sleep 1
            waited=$((waited + 1))
        done
    fi
fi

run_pnpm() {
    if [ -x "$PNPM_BIN" ]; then
        "$PNPM_BIN" "$@"
    else
        npx -y "pnpm@$PNPM_VERSION" "$@"
    fi
}

exec_pnpm() {
    if [ -x "$PNPM_BIN" ]; then
        exec "$PNPM_BIN" "$@"
    fi
    warn "pinned pnpm $PNPM_VERSION is not installed; running npx -y pnpm@$PNPM_VERSION for this command"
    exec npx -y "pnpm@$PNPM_VERSION" "$@"
}

# --- 2. pnpm's in-command install is off for the command it runs ---------------------
pnpm_config_verify_deps_before_run=false
export pnpm_config_verify_deps_before_run

# --- 3. classify ---------------------------------------------------------------------

# resolve_dir VALUE: absolute form of a directory option value.
resolve_dir() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *)  printf '%s/%s\n' "$(pwd -P)" "$1" ;;
    esac
}

# classify ARGS: sets KIND (info, mutate or project) and TARGET (see header).
classify() {
    KIND=info
    TARGET="$(pwd -P)"
    want_value=""
    command_seen=0
    for a in "$@"; do
        if [ -n "$want_value" ]; then
            case "$want_value" in
                dir) TARGET="$(resolve_dir "$a")" ;;
            esac
            want_value=""
            continue
        fi
        case "$a" in
            --) return 0 ;;
            -C|--dir|--prefix) want_value=dir; continue ;;
            -C=*) TARGET="$(resolve_dir "${a#-C=}")"; continue ;;
            --dir=*) TARGET="$(resolve_dir "${a#--dir=}")"; continue ;;
            --prefix=*) TARGET="$(resolve_dir "${a#--prefix=}")"; continue ;;
            -F|--filter|--filter-prod|--changed-files-ignore-pattern|--test-pattern| \
            --loglevel|--reporter|--workspace-concurrency|--lockfile-dir|--lockfile-directory| \
            --store-dir|--virtual-store-dir|--modules-dir|--cache-dir|--state-dir|--registry| \
            --network-concurrency|--fetch-retries|--fetch-retry-factor|--fetch-retry-mintimeout| \
            --fetch-retry-maxtimeout|--fetch-timeout|--proxy|--https-proxy|--noproxy|--userconfig| \
            --use-node-version|--node-version|--resolution-mode|--npm-path|--config-dir)
                want_value=other; continue ;;
            -*) continue ;;
        esac
        if [ "$command_seen" -eq 2 ]; then
            return 0        # the script or bin name: what follows belongs to it
        fi
        [ "$command_seen" -eq 0 ] || continue
        case "$a" in
            recursive|multi|m|pm) continue ;;
            with) want_value=other; continue ;;
        esac
        command_seen=1
        case "$a" in
            install|i|ci|install-clean|ic|clean-install|install-test|it|add|remove|rm|uninstall|un| \
            update|up|upgrade|link|ln|unlink|dislink|import|prune|fetch|dedupe|rebuild|rb| \
            patch|patch-commit|patch-remove|approve-builds|deploy|setup|clean|purge)
                KIND=mutate ;;
            store|config|c|env|self-update|outdated|audit|list|ls|ll|la|why|pack|pack-app|publish| \
            stage|licenses|cat-file|cat-index|find-hash|ignored-builds|init|create|dlx|doctor|help| \
            root|bin|server|completion|cache|access|adduser|bugs|deprecate|undeprecate|dist-tag| \
            dist-tags|docs|find|home|info|issues|login|logout|owner|ping|pkg|repo|s|sbom|se|search| \
            set-script|show|ss|star|stars|team|unpublish|unstar|v|version|view|whoami)
                KIND=info ;;
            run|run-script|exec)
                # pnpm's own options may still follow, up to the script or bin name
                KIND=project
                command_seen=2 ;;
            *)
                # a script or bin name: what follows belongs to it
                KIND=project
                return 0 ;;
        esac
    done
}

# lane_of DIR: nearest ancestor of DIR (DIR included) holding pnpm-lock.yaml;
# 1 when there is none.
lane_of() {
    d="$(cd -P "$1" 2>/dev/null && pwd -P)" || return 1
    while :; do
        if [ -f "$d/pnpm-lock.yaml" ]; then
            printf '%s\n' "$d"
            return 0
        fi
        [ "$d" != "/" ] || return 1
        d="${d%/*}"
        [ -n "$d" ] || d="/"
    done
}

# deps_in_sync: pnpm's own verdict on TARGET, read-only, running nothing.
deps_in_sync() {
    (
        unset pnpm_config_verify_deps_before_run
        cd "$TARGET" && run_pnpm --config.verify-deps-before-run=error exec true
    ) >/dev/null 2>&1
}

# --- the lane lock -----------------------------------------------------------------
LOCK=""
LOCKED=0
release_lock() {
    if [ "$LOCKED" -eq 1 ]; then
        LOCKED=0
        [ "$(cat "$LOCK/pid" 2>/dev/null || true)" = "$$" ] || return 0
        rm -f "$LOCK/pid" 2>/dev/null || true
        rmdir "$LOCK" 2>/dev/null || true
    fi
}
trap 'release_lock' EXIT
trap 'release_lock; exit 129' HUP
trap 'release_lock; exit 130' INT
trap 'release_lock; exit 143' TERM

owner_is_dead() {
    ! kill -0 "$1" 2>/dev/null && return 0
    case "$(ps -o stat= -p "$1" 2>/dev/null | tr -d ' ')" in
        Z*) return 0 ;;
    esac
    return 1
}

# lock_is_stale: $LOCK exists and its owner is dead or a zombie, or it has had
# no owner for over two minutes (a run died between mkdir and the pid write;
# a live run publishes within milliseconds). Sets `owner`.
lock_is_stale() {
    [ -d "$LOCK" ] || return 1
    owner="$(cat "$LOCK/pid" 2>/dev/null || true)"
    if [ -n "$owner" ]; then
        owner_is_dead "$owner"
    else
        [ -n "$(find "$LOCK" -maxdepth 0 -mmin +2 2>/dev/null)" ]
    fi
}

# reclaim_stale_lock: move $LOCK aside if, under the reclaim lock, it is still
# stale. 0 when something was moved, 1 otherwise (lost the reclaim race, the
# lock turned out live or gone). A reclaim lock older than two minutes is a
# crash residue and fails the command closed rather than being removed here
# (two contenders removing it would race exactly like the primary lock).
reclaim_stale_lock() {
    reclaim="$LOCK.reclaim"
    if ! mkdir "$reclaim" 2>/dev/null; then
        if [ -n "$(find "$reclaim" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then
            die "stale reclaim lock $reclaim is older than two minutes; remove it by hand after checking no lane install is alive"
        fi
        return 1
    fi
    [ -z "${GC_TOOLCHAIN_TEST_PAUSE_IN_RECLAIM:-}" ] || sleep "$GC_TOOLCHAIN_TEST_PAUSE_IN_RECLAIM"
    moved=1
    if lock_is_stale; then
        aside="$LOCK.stale-${owner:-nopid}-$$"
        if mv "$LOCK" "$aside" 2>/dev/null; then
            warn "moved aside a stale lane install lock (owner pid ${owner:-none}) -> $aside"
            moved=0
        fi
    fi
    rmdir "$reclaim" 2>/dev/null || true
    return "$moved"
}

# take_lane_lock: hold $LOCK on return. Fails closed after LANE_DEPS_WAIT
# seconds behind a live holder.
take_lane_lock() {
    mkdir -p "$NM" 2>/dev/null || die "cannot create $NM (read-only here?)"
    waited=0
    while :; do
        if mkdir "$LOCK" 2>/dev/null; then
            LOCKED=1
            printf '%s\n' "$$" > "$LOCK/pid"
            return 0
        fi
        if lock_is_stale; then
            [ -z "${GC_TOOLCHAIN_TEST_PAUSE_BEFORE_RECLAIM:-}" ] || sleep "$GC_TOOLCHAIN_TEST_PAUSE_BEFORE_RECLAIM"
            if reclaim_stale_lock; then
                continue
            fi
        fi
        [ "$waited" -lt "$LANE_DEPS_WAIT" ] \
            || die "another lane install (pid ${owner:-unknown}) has held $LOCK for ${LANE_DEPS_WAIT}s; this command did not run"
        [ "$waited" -gt 0 ] || log "waiting for another caller's lane install (pid ${owner:-unknown})"
        sleep 1
        waited=$((waited + 1))
    done
}

classify "$@"
if [ "$LANE_DEPS" = "off" ] || [ "$KIND" = "info" ]; then
    exec_pnpm "$@"
fi
if LANE="$(lane_of "$TARGET")"; then
    :
elif [ "$KIND" = "mutate" ]; then
    # a first install creates the lockfile: the lane is the directory pnpm acts on
    LANE="$(cd -P "$TARGET" 2>/dev/null && pwd -P)" || exec_pnpm "$@"
else
    exec_pnpm "$@"     # no lockfile anywhere above: nothing to keep in sync
fi
if [ "${GC_TOOLCHAIN_LANE_DEPS_INSTALLING:-}" = "$LANE" ]; then
    exec_pnpm "$@"     # a lifecycle script of the mutation in progress; its parent holds the lock
fi
NM="$LANE/node_modules"
LOCK="$NM/.gc-lane-deps.lock"

case "$KIND" in
    mutate)
        take_lane_lock
        status=0
        GC_TOOLCHAIN_LANE_DEPS_INSTALLING="$LANE" run_pnpm "$@" || status=$?
        release_lock
        exit "$status"
        ;;
    project)
        if deps_in_sync; then
            exec_pnpm "$@"
        fi
        take_lane_lock
        if ! deps_in_sync; then
            log "installing lane dependencies once for $LANE (pnpm says node_modules is out of sync)"
            status=0
            (cd "$LANE" && GC_TOOLCHAIN_LANE_DEPS_INSTALLING="$LANE" run_pnpm install --frozen-lockfile) >&2 || status=$?
            release_lock
            [ "$status" -eq 0 ] || die "lane install failed (pnpm install --frozen-lockfile exit $status); this command did not run"
        fi
        release_lock
        exec_pnpm "$@"
        ;;
esac
