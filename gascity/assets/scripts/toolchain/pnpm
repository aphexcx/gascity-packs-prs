#!/bin/sh
# pnpm — gc worker toolchain wrapper. Install as $CITY/.gc/shims/toolchain/pnpm
# (README, "Worker toolchain"), the directory a provider shim puts first on
# PATH for every worker session and its child processes.
#
# What it does, in order:
#   1. pnpm itself is installed ONCE under the city, never machine-wide:
#      <toolchain dir>/pnpm/node_modules/.bin/pnpm (npm --prefix). The first
#      caller installs, concurrent callers wait for it; a caller that still
#      finds no binary runs `npx -y pnpm@<version>` for this one command.
#   2. pnpm's own dependency check is turned off for the command
#      (pnpm_config_verify_deps_before_run=false). pnpm 11 defaults
#      verify-deps-before-run to "install": every `pnpm run`, `pnpm exec`,
#      `pnpm test` and bare `pnpm <script>` first re-runs `pnpm install` when
#      node_modules is out of sync with the lockfile (missing after a fresh
#      lane, stale after a branch switch), and parallel read-only checks then
#      race on the same node_modules. The lane install below is the one path.
#   3. Lane dependencies are installed ONCE per lockfile: for a command that
#      runs project code (anything but the package-management and
#      informational subcommands listed in lane_deps_passthrough), the
#      nearest ancestor of the working directory holding pnpm-lock.yaml is
#      the project; node_modules/.gc-lane-deps records the sha256 of the
#      lockfile the current install was made from. A matching marker means
#      no install. Otherwise one caller takes node_modules/.gc-lane-deps.lock
#      (mkdir), runs `pnpm install --frozen-lockfile` in the project, writes
#      the marker on success and releases; every concurrent caller waits for
#      the lock, then re-reads the marker. A failed install writes no marker
#      and fails this command (exit status of pnpm install); the requested
#      command does not run against a half-installed tree. A lock whose owner
#      pid is dead (or a zombie), or that has no owner after two minutes, is
#      moved aside by rename (atomic; nothing is deleted) and retaken; a live
#      lock is waited for up to <wait> seconds, then this command fails
#      closed naming the holder.
#   4. The wrapper's own directory goes first on PATH, so the node pnpm runs
#      on (and every script it runs) is the toolchain's node when the city
#      pinned one (see the node wrapper beside this file).
#
# Settings (environment wins; then toolchain.env beside this file, plain
# KEY=VALUE lines, never evaluated; then the default):
#   GC_TOOLCHAIN_DIR / TOOLCHAIN_DIR             where pinned tools live
#                                                (default: <shim dir>/../../toolchain,
#                                                 i.e. $CITY/.gc/toolchain)
#   GC_TOOLCHAIN_PNPM_VERSION / PNPM_VERSION     pnpm to install (default 11.20.0;
#                                                pnpm honours a repo's packageManager
#                                                pin on top of it)
#   GC_TOOLCHAIN_LANE_DEPS / LANE_DEPS           "off" disables step 3
#   GC_TOOLCHAIN_LANE_DEPS_WAIT / LANE_DEPS_WAIT seconds to wait for another
#                                                caller's install (default 600)
#
# The project is resolved from the working directory only; `pnpm -C <dir>`
# and `--dir` are passed through unchanged but do not move the lane install.

set -eu

log() { printf 'gc-toolchain pnpm: %s\n' "$*" >&2; }
warn() { printf 'gc-toolchain pnpm: WARN %s\n' "$*" >&2; }
die() { printf 'gc-toolchain pnpm: ERROR %s\n' "$*" >&2; exit 1; }

# --- locate self with parameter expansion only ------------------------------------
case "$0" in
    */*) self_dir="${0%/*}" ;;
    *)   self_dir="." ;;
esac
[ -n "$self_dir" ] || self_dir="/"
SELF_DIR="$(cd -P "$self_dir" 2>/dev/null && pwd -P)" || die "cannot resolve my own directory from $0"
SIDECAR="$SELF_DIR/toolchain.env"

# setting NAME ENV_NAME DEFAULT: environment (even empty) wins over the
# sidecar; the sidecar is read as text, first matching line, never evaluated.
setting() {
    # shellcheck disable=SC2154  # v is assigned by the eval on the next line
    eval "v=\${$2-__unset__}"
    if [ "$v" != "__unset__" ]; then
        printf '%s\n' "$v"
        return 0
    fi
    if [ -r "$SIDECAR" ]; then
        line="$(grep -- "^$1=" "$SIDECAR" 2>/dev/null | sed -n '1p')"
        if [ -n "$line" ]; then
            printf '%s\n' "${line#*=}"
            return 0
        fi
    fi
    printf '%s\n' "$3"
}

TOOLCHAIN_DIR="$(setting TOOLCHAIN_DIR GC_TOOLCHAIN_DIR "")"
if [ -z "$TOOLCHAIN_DIR" ]; then
    TOOLCHAIN_DIR="$SELF_DIR/../../toolchain"
fi
case "$TOOLCHAIN_DIR" in
    /*) ;;
    *) TOOLCHAIN_DIR="$SELF_DIR/$TOOLCHAIN_DIR" ;;
esac
PNPM_VERSION="$(setting PNPM_VERSION GC_TOOLCHAIN_PNPM_VERSION 11.20.0)"
LANE_DEPS="$(setting LANE_DEPS GC_TOOLCHAIN_LANE_DEPS on)"
LANE_DEPS_WAIT="$(setting LANE_DEPS_WAIT GC_TOOLCHAIN_LANE_DEPS_WAIT 600)"
case "$LANE_DEPS_WAIT" in
    ''|*[!0-9]*) LANE_DEPS_WAIT=600 ;;
esac

# The toolchain's own tools first, so `node` under pnpm is the pinned one.
case ":$PATH:" in
    "$SELF_DIR:"*) ;;
    *) PATH="$SELF_DIR:$PATH" ;;
esac
export PATH

# --- 1. pnpm itself, once under the city -------------------------------------------
PNPM_ROOT="$TOOLCHAIN_DIR/pnpm"
PNPM_BIN="$PNPM_ROOT/node_modules/.bin/pnpm"
if [ ! -x "$PNPM_BIN" ]; then
    if mkdir -p "$PNPM_ROOT" 2>/dev/null && mkdir "$PNPM_ROOT/.installing" 2>/dev/null; then
        log "installing pnpm $PNPM_VERSION once under $PNPM_ROOT"
        npm install --prefix "$PNPM_ROOT" --no-audit --no-fund --loglevel=error "pnpm@$PNPM_VERSION" >&2 \
            || warn "pnpm $PNPM_VERSION did not install under $PNPM_ROOT"
        rmdir "$PNPM_ROOT/.installing" 2>/dev/null || true
    else
        waited=0
        while [ -d "$PNPM_ROOT/.installing" ] && [ "$waited" -lt 120 ]; do
            [ "$waited" -gt 0 ] || log "waiting for another caller's pnpm install"
            sleep 1
            waited=$((waited + 1))
        done
    fi
fi

run_pnpm() {
    if [ -x "$PNPM_BIN" ]; then
        "$PNPM_BIN" "$@"
    else
        npx -y "pnpm@$PNPM_VERSION" "$@"
    fi
}

# --- 2. pnpm's per-command install is off; the lane install below is the path ------
pnpm_config_verify_deps_before_run=false
export pnpm_config_verify_deps_before_run

# --- 3. lane dependencies, once per lockfile ---------------------------------------

# lane_deps_passthrough ARGS: true when the command manages packages or only
# reports (no project code runs), or when there is no subcommand at all.
lane_deps_passthrough() {
    for a in "$@"; do
        case "$a" in
            -*) continue ;;
        esac
        case "$a" in
            install|i|add|remove|rm|uninstall|un|update|up|upgrade|link|ln|unlink|dislink| \
            import|prune|fetch|dedupe|rebuild|rb|store|config|c|setup|env|self-update| \
            outdated|audit|list|ls|ll|la|why|patch|patch-commit|patch-remove|pack|publish| \
            licenses|cat-file|cat-index|find-hash|approve-builds|ignored-builds|init|create| \
            dlx|doctor|help|root|bin|server|completion|deploy|cache)
                return 0 ;;
            *)
                return 1 ;;
        esac
    done
    return 0
}

# project_root: nearest ancestor of the working directory holding pnpm-lock.yaml.
project_root() {
    d="$(pwd -P)"
    while :; do
        if [ -f "$d/pnpm-lock.yaml" ]; then
            printf '%s\n' "$d"
            return 0
        fi
        [ "$d" != "/" ] || return 1
        d="${d%/*}"
        [ -n "$d" ] || d="/"
    done
}

sha256_of() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 -- "$1" | sed 's/ .*//'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum -- "$1" | sed 's/ .*//'
    else
        cksum -- "$1" | sed 's/ .*//'
    fi
}

LOCK=""
LOCKED=0
release_lock() {
    if [ "$LOCKED" -eq 1 ]; then
        rm -f "$LOCK/pid" 2>/dev/null || true
        rmdir "$LOCK" 2>/dev/null || true
        LOCKED=0
    fi
}
trap 'release_lock' EXIT
trap 'release_lock; exit 129' HUP
trap 'release_lock; exit 130' INT
trap 'release_lock; exit 143' TERM

owner_is_dead() {
    ! kill -0 "$1" 2>/dev/null && return 0
    case "$(ps -o stat= -p "$1" 2>/dev/null | tr -d ' ')" in
        Z*) return 0 ;;
    esac
    return 1
}

marker_ok() { [ -f "$MARK" ] && [ "$(cat "$MARK" 2>/dev/null)" = "$WANT" ]; }

ensure_lane_deps() {
    ROOT="$(project_root)" || return 0
    NM="$ROOT/node_modules"
    MARK="$NM/.gc-lane-deps"
    LOCK="$NM/.gc-lane-deps.lock"
    WANT="$(sha256_of "$ROOT/pnpm-lock.yaml")"
    marker_ok && return 0
    mkdir -p "$NM" 2>/dev/null || die "cannot create $NM to install lane dependencies (read-only here?)"
    waited=0
    while :; do
        if mkdir "$LOCK" 2>/dev/null; then
            LOCKED=1
            printf '%s\n' "$$" > "$LOCK/pid"
            break
        fi
        marker_ok && return 0
        owner="$(cat "$LOCK/pid" 2>/dev/null || true)"
        stale=0
        if [ -n "$owner" ]; then
            owner_is_dead "$owner" && stale=1
        elif [ -n "$(find "$LOCK" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then
            stale=1
        fi
        if [ "$stale" -eq 1 ]; then
            aside="$LOCK.stale-${owner:-nopid}-$$"
            if mv "$LOCK" "$aside" 2>/dev/null; then
                warn "moved aside a stale lane install lock (owner pid ${owner:-none}) -> $aside"
                continue
            fi
            # lost the rename race to another waiter; loop and retake
            continue
        fi
        [ "$waited" -lt "$LANE_DEPS_WAIT" ] \
            || die "another lane install (pid ${owner:-unknown}) has held $LOCK for ${LANE_DEPS_WAIT}s; this command did not run"
        [ "$waited" -gt 0 ] || log "waiting for another caller's lane install (pid ${owner:-unknown})"
        sleep 1
        waited=$((waited + 1))
    done
    # Holder. A previous holder may have finished while we waited.
    if marker_ok; then
        release_lock
        return 0
    fi
    short="$(printf '%s' "$WANT" | cut -c1-12)"
    log "installing lane dependencies once for $ROOT (lockfile $short)"
    status=0
    (cd "$ROOT" && run_pnpm install --frozen-lockfile) >&2 || status=$?
    if [ "$status" -eq 0 ]; then
        printf '%s\n' "$WANT" > "$MARK.tmp.$$" && mv "$MARK.tmp.$$" "$MARK"
    fi
    release_lock
    [ "$status" -eq 0 ] || die "lane install failed (pnpm install --frozen-lockfile exit $status); this command did not run"
    return 0
}

if [ "$LANE_DEPS" != "off" ] && ! lane_deps_passthrough "$@"; then
    ensure_lane_deps
fi

if [ -x "$PNPM_BIN" ]; then
    exec "$PNPM_BIN" "$@"
fi
warn "pinned pnpm $PNPM_VERSION is not installed; running npx -y pnpm@$PNPM_VERSION for this command"
exec npx -y "pnpm@$PNPM_VERSION" "$@"
